--- a/Save/TPZBFileStream.cpp
+++ b/Save/TPZBFileStream.cpp
@@ -104,3 +104,11 @@ void TPZBFileStream::ReadData<int>(int* p, int howMany);
 
 template
 void TPZBFileStream::ReadData<long>(long* p, int howMany);
+
+/** No macOS/arm64 int64_t e long long (no Linux, long) — sem estas duas
+    instanciacoes o link da libpz falha por simbolo indefinido. */
+template
+void TPZBFileStream::ReadData<long long>(long long* p, int howMany);
+
+template
+void TPZBFileStream::WriteData<long long const>(long long const* p, int howMany);
